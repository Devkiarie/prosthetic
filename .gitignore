# === Python / ML ===
ml/venv/
ml/data/ninapro_db5/          # NinaPro is large + license restricts redistribution
ml/data/processed/*.npy        # Regenerable from train_v3.py
ml/models/*.keras              # Large float32 models — regenerable
ml/models/*.tflite             # Binaries — firmware/model/ has the canonical copy
ml/models/*.npy                # Normalisation stats — regenerable
ml/models/*.pkl                # Sklearn baseline models — regenerable
ml/models/*.h5
ml/models/training_log*.txt    # Training logs — regenerable
ml/models/semg_weights.h       # Old C header
ml/models/semg_v3_weights.h    # C header — canonical copy is firmware/model/
ml/models/*_saved_model/       # SavedModel dirs — regenerable intermediates
__pycache__/
*.pyc
.ipynb_checkpoints/

# === PlatformIO / Firmware ===
firmware/.pio/                 # Build cache (large, regenerable)
firmware/.vscode/
firmware/model/semg_v3_weights.h  # Generated C array — regenerable, 235KB

# === KiCad ===
hardware/kicad/*-backups/
hardware/kicad/*.kicad_prl
hardware/kicad/fp-info-cache

# === Simulation ===
hardware/simulation/*.raw      # ngspice raw output (regenerable)

